<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cloud.ashesborn.embedding-jina</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>server.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__SERVER_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>MODEL_PATH</key>
    <string>__MODEL_PATH__</string>
    <key>MODEL_ID</key>
    <string>jina-embeddings-v5-text-small-retrieval</string>
    <key>PORT</key>
    <string>1235</string>
    <key>GPU</key>
    <string>metal</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__SERVER_DIR__/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__SERVER_DIR__/launchd.err.log</string>
</dict>
</plist>
