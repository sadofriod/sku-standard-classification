# 数据源（属性抽取用的 OpenAI 兼容端点；键留空则跳过 LLM 步骤，只跑确定性基线）
LLM_API_KEY="sk-..."
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-chat"

# 图谱层（可选，见 docs/embedding-service.md）
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sku_graph?schema=public"

RAG_SLICE_API_KEY="sk-..."
RAG_SLICE_MODEL="deepseek-chat"
RAG_SLICE_BASE_URL="https://api.deepseek.com/v1"

RAG_JUDGE_API_KEY="sk-..."
RAG_JUDGE_MODEL="deepseek-chat"
RAG_JUDGE_BASE_URL="https://api.deepseek.com/v1"

# 向量维度需与 prisma/schema.prisma 的 vector(N) 一致
RAG_EMBED_API_KEY="local"
RAG_EMBED_MODEL="jina-embeddings-v5-text-small-retrieval"
RAG_EMBED_BASE_URL="http://127.0.0.1:1235/v1"
